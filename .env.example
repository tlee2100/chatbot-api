# Database
DB_TYPE=postgres
DB_HOST=localhost
DB_PORT=5432
DB_USERNAME=postgres
DB_PASSWORD=123456
DB_DATABASE=nestjs_db

# Auth
JWT_SECRET=your_jwt_secret
TWO_FACTOR_SECRET=your_2fa_secret
RECAPTCHA_SECRET_KEY=your_recaptcha_secret_key
# Set to "true" to skip reCAPTCHA verification on /auth/login (local dev only)
DISABLE_RECAPTCHA=true
CHAT_IDLE_TIMEOUT_MINUTES=30


# Redis
REDIS_HOST=localhost
REDIS_PORT=6379


JWT_REFRESH_SECRET=development_refresh_token_secret
JWT_ACCESS_EXPIRES_IN=900       
JWT_REFRESH_EXPIRES_IN=604800  

# AI Configuration
DEEPSEEK_API_KEY="your-key"
DEEPSEEK_BASE_URL=https://api.ai-box.vn/v1
SYSTEM_PROMPT="You are a helpful customer support chatbot. Please assist the visitor with their inquiries."

OPENAI_API_KEY="your-key"

INTERNAL_API_KEY=super-secret-key-36
MCP_SERVER_URL=http://localhost:3002/mcp/sse